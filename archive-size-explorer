def requested_series(asked):
    """Split a --series request into (main tier, separate tier).

    With nothing asked for that is every candidate plus every separate
    series.  An explicit request is honoured as given, with each name routed
    to whichever tier it belongs to -- so -s xenial aggregates xenial alone,
    which is what it would have done anyway.
    """
    if not asked:
        return list(CANDIDATE_SERIES), list(SEPARATE_SERIES)
    return ([s for s in asked if s not in SEPARATE_SERIES],
            [s for s in asked if s in SEPARATE_SERIES])


def series_order(names):
    """Release order, so the page can treat a higher index as 'more recent'.

    Anything unrecognised sorts after the known series rather than failing, so
    a series that turns up before this list hears about it still renders.
    """
    return sorted(names, key=lambda n: (RELEASE_ORDER.index(n)
                                        if n in RELEASE_ORDER
                                        else len(RELEASE_ORDER), n))


def add_common(parser):
    parser.add_argument("-s", "--series", action="append", metavar="SERIES",
                        help="series to include; repeatable "
                             "(default: every series present in the window)")
    parser.add_argument("-a", "--arch", action="append", metavar="ARCH",
                        help="binary architecture; repeatable "
                             "(default: every arch each suite advertises)")
    parser.add_argument("-p", "--pocket", action="append", metavar="POCKET",
                        choices=POCKETS,
                        help="pocket; repeatable (default: all of %s)"
                             % ", ".join(POCKETS))
    parser.add_argument("-c", "--component", action="append", metavar="COMP",
                        choices=DEFAULT_COMPONENTS,
                        help="component; repeatable (default: all four)")
    parser.add_argument("--no-sources", action="store_true",
                        help="skip source packages (they show up as arch "
                             "'source')")
    parser.add_argument("--cache", default=default_cache_dir(), metavar="DIR",
                        help="cache directory (default: %(default)s)")
    parser.add_argument("-j", "--jobs", type=int, default=8, metavar="N",
                        help="parallel downloads (default: %(default)s)")
    parser.add_argument("--offline", action="store_true",
                        help="use only what is already cached; skip anything "
                             "that would need the network")


def add_window(parser):
    parser.add_argument("--from", dest="from_", default=None, metavar="YYYY-MM",
                        help="first snapshot (default: 2023-03, the earliest "
                             "the snapshot service has)")
    parser.add_argument("--to", default=None, metavar="YYYY-MM",
                        help="last snapshot (default: today)")
    parser.add_argument("--every", default="month", metavar="SPEC",
                        help="'month' (default), 'week', or a number of days")


def make_builder(args):
    cache = Cache(args.cache)
    fetcher = Fetcher(jobs=args.jobs)
    builder = Builder(cache, fetcher,
                      components=args.component,
                      arches=args.arch,
                      pockets=args.pocket,
                      sources=not args.no_sources)
    if args.offline:
        builder.fetcher = OfflineFetcher()
    return builder


class OfflineFetcher:
    jobs = 1
    bytes_downloaded = 0

    def get(self, url, tolerate_404=True, head=False):
        raise SkipOffline(url)

    def exists(self, url):
        raise SkipOffline(url)


class SkipOffline(Exception):
    pass


def mirror_series(builder, series_list):
    """Which of series_list the live archive still carries.

    Cached for MIRROR_MAX_AGE, so this costs a dozen requests once a week
    rather than once a build.  Returns None when there is no answer to be had
    -- an --offline run that has never probed -- which leaves the page to fall
    back to guessing from the snapshot data.
    """
    cached = builder.cache.get_mirror()
    fresh = (cached is not None and cached[1] <= MIRROR_MAX_AGE
             and all(s in cached[0] for s in series_list))
    if fresh:
        kept = [s for s in series_list if cached[0][s]]
        log("mirror probe %.1f days old, not renewing: %d of %d series still "
            "carried (%s)"
            % (cached[1] / 86400.0, len(kept), len(series_list),
               " ".join(kept)))
        return kept
    try:
        present = probe_mirror(builder.fetcher, series_list)
    except (SkipOffline, requests.RequestException) as e:
        # The probe is a nicety -- it decides what the page opens with, not
        # what it holds -- so a sulking archive must not take a build down.
        if cached is None or not all(s in cached[0] for s in series_list):
            log("no usable mirror probe (%s): the page will fall back to "
                "guessing which series are still carried"
                % ("offline" if isinstance(e, SkipOffline) else e))
            return None
        log("mirror probe is %.0f days old and could not be renewed (%s), "
            "using it anyway"
            % (cached[1] / 86400.0,
               "offline" if isinstance(e, SkipOffline) else e))
        return [s for s in series_list if cached[0][s]]
    builder.cache.put_mirror(present)
    kept = [s for s in series_list if present[s]]
    log("mirror probe: %d of %d series still on %s (%s)"
        % (len(kept), len(present), ARCHIVE_BASE, " ".join(kept)))
    return kept


def live_token(builder, names, refresh):
    """A content-addressed token standing for the live suites' current state.

    Pinned by default.  The token is part of the aggregate key, so letting it
    follow the archive would re-aggregate every snapshot each time trusty or
    xenial publishes -- hours of work triggered by someone else's upload.
    Pinning makes that a thing you ask for with --refresh-live, and leaves an
    ordinary rebuild reading nothing from the network for these series.

    Returns None when there is nothing usable, which leaves them out.
    """
    if not names:
        return None
    pinned = builder.cache.get_live_pin()
    if pinned and not refresh:
        return pinned
    try:
        entries = live_entries(builder, names)
    except (SkipOffline, requests.RequestException, RuntimeError) as e:
        if pinned:
            log("keeping the pinned live state (%s)" % e)
            return pinned
        log("no live state and none pinned (%s); leaving out %s"
            % (e, " ".join(names)))
        return None
    if not entries:
        log("the live archive has none of %s" % " ".join(names))
        return None
    token = "%s-%s" % (LIVE, live_digest(entries))
    if token == pinned:
        log("live state unchanged: %s" % token)
        return token
    # Write the Releases under the new token so the aggregates that cite it
    # can be rebuilt from cache later.
    live_entries(builder, names, token=token)
    builder.cache.put_live_pin(token)
    log("live state is now %s%s" % (token, " (was %s)" % pinned if pinned
                                    else ""))
    return token


def tally_indexes(cache, plans, is_kernel, into):
    """Size and entry count of every index behind one snapshot.

    Deliberately not deduplicated: the archive really does publish one
    binary-<arch>/Packages per component per pocket per series, and an
    Architecture: all package really is a stanza in each of them.  That is what
    makes this table different in kind from the others -- it measures the lists
    rather than the pool they point at.

    A second pass over the blobs, because kernel-ness is a property of the
    whole snapshot and is not known until every index has been read.  Nothing
    is downloaded here; load_rows has already put it all in the cache.
    """
    counted = {}
    for series, plan in plans:
        for ix in plan:
            tally = counted.get(ix.sha)
            if tally is None:
                tally = counted[ix.sha] = count_index(cache, ix.sha, is_kernel)
            acc = into.setdefault(
                (series, ix.pocket, ix.component, ix.arch), [0, 0, 0, 0])
            acc[0] += tally[0]
            acc[1] += tally[1]
            acc[2] += ix.csize
            acc[3] += ix.usize


def aggregate_snapshot(builder, snap, series_list, live_names=(),
                       live_token=None):
    """Merge one snapshot's pool over series_list and aggregate it.

    Returns (cls_table, flav_table, idx_table, here, partial), where `here`
    names the series that existed at this snapshot and `partial` says a read
    was skipped -- which makes the result unfit to cache.

    Masks come from SERIES_BITS, so they mean the same thing whatever subset
    of series this was called with, and two results can be mixed as they are.

    A series in live_names is read from live_token instead of from snap.  It
    has to be merged here rather than added afterwards: the pool is shared
    across series, and a file two of them reference needs one row with a wider
    mask, not two rows.  Folding trusty and xenial in separately overstated
    the archive by 36.14 GiB, nearly all of it arch-independent data packages
    at identical versions across releases.
    """
    whole = {}
    plans = []
    here = []
    partial = False
    for series in series_list:
        src = live_token if series in live_names else snap
        try:
            rows = builder.load_rows(src, series)
        except SkipOffline:
            partial = True
            continue
        if rows is None:
            continue
        here.append(series)
        plans.append((series, builder.plan(src, series)))
        merge_rows(whole, rows, series_bit(series))
        del rows
    if not whole:
        return None, None, {}, here, partial
    is_kernel = kernel_predicate(whole)
    cls_table, flav_table = aggregate(whole, is_kernel)
    idx_table = {}
    tally_indexes(builder.cache, plans, is_kernel, idx_table)
    del whole
    return cls_table, flav_table, idx_table, here, partial


def fold_separate(builder, snap, series, byclass, byflavour, byindex):
    """Add one separately-aggregated series into a snapshot's tables.

    Its aggregate is cached under a key naming only itself, which is what
    keeps it independent of the main tier: adding or dropping it leaves every
    other cache entry valid.  Sound only because the series shares no pool
    file with anything else -- see SEPARATE_SERIES.  A shared file would land
    here as a second row rather than as a wider mask, and so be counted twice.

    Returns (series found, whether the aggregate came from the cache).
    """
    key = aggregate_key([series], builder.components, builder.arches,
                        builder.pockets, builder.sources)
    cached = builder.cache.get_aggregate(snap, key)
    if cached is not None:
        cls_table, flav_table, idx_table, here = cached
    else:
        cls_table, flav_table, idx_table, here, partial = \
            aggregate_snapshot(builder, snap, [series])
        if cls_table and not partial:
            builder.cache.put_aggregate(snap, key, cls_table, flav_table,
                                        idx_table, here)
    mask = series_bit(series)
    if cls_table:
        for k, acc in cls_table.items():
            # One series in, so the only mask it can carry is its own bit.
            assert k[0] == mask, (series, k)
            byclass[(snap, mask) + k[1:]] = acc
        for k, acc in flav_table.items():
            assert k[0] == mask, (series, k)
            byflavour[(snap, mask) + k[1:]] = acc
    # Index rows carry the series by name, so they need no shifting.
    for k, acc in idx_table.items():
        byindex[(snap,) + k] = acc
    return here, cached is not None


def drop_removed(byclass, byflavour, byindex, series_list):
    """Stop counting a series once it had left the mirror.

    The aggregate tables say what the snapshot service held, which keeps a
    suite long after the archive has dropped it.  This turns them into what
    the archive held, by clearing a removed series' bit from every snapshot
    after its removal and discarding whatever is then referenced by nobody.

    Clearing a bit can collapse two rows onto one key -- the same class in the
    same place, previously distinguished only by which series referenced it --
    and those rows count disjoint sets of files, so the accumulators add.

    Returns the three tables, and the number of bytes it stopped counting at
    the most recent snapshot, which is the figure worth reporting.
    """
    gone = {s: series_bit(s) for s in series_list if s in MIRROR_REMOVED}
    if not gone:
        return byclass, byflavour, byindex, 0

    def surviving_mask(snap, smask):
        for series, bit in gone.items():
            if smask & bit and removed_after(series, snap):
                smask &= ~bit
        return smask

    last = max((k[0] for k in byclass), default=None)
    dropped = 0
    out_class, out_flav = {}, {}
    for key, acc in byclass.items():
        snap, smask = key[0], key[1]
        kept = surviving_mask(snap, smask)
        if not kept:
            if snap == last:
                dropped += acc[1]
            continue
        # Every surviving row goes through the same accumulate, including the
        # ones whose mask did not change.  Writing those straight through
        # instead would overwrite a row that had already been trimmed onto the
        # same key, losing its bytes -- and which came first depends on dict
        # order, so it looked like dedup rather than a bug.
        new_key = key if kept == smask else (snap, kept) + key[2:]
        prev = out_class.get(new_key)
        if prev is None:
            out_class[new_key] = list(acc)
        else:
            for i in range(len(acc)):
                prev[i] += acc[i]
    for key, acc in byflavour.items():
        snap, smask = key[0], key[1]
        kept = surviving_mask(snap, smask)
        if not kept:
            continue
        new_key = key if kept == smask else (snap, kept) + key[2:]
        prev = out_flav.get(new_key)
        if prev is None:
            out_flav[new_key] = list(acc)
        else:
            for i in range(len(acc)):
                prev[i] += acc[i]
    # Index rows name their series outright, so there is nothing to merge.
    out_idx = {k: v for k, v in byindex.items()
               if not removed_after(k[1], k[0])}
    return out_class, out_flav, out_idx, dropped


def snapshot_key(builder, snap, series_list, live_names=(),
                 live_token=None):
    """Cache key for this snapshot's aggregate, or None if it cannot be named.

    Keyed on the series that are really at this snapshot rather than the ones
    that were asked for, which is what makes adding a series cheap: tenacious
    opened in October 2026, so it changes the key at the one monthly snapshot
    that has it and leaves the other forty-four hitting the cache.  Settling
    that costs Release lookups, which are cached and which the aggregation
    would make anyway.

    None means the question could not be answered -- an --offline run whose
    cache never saw one of these suites.  The caller then neither reads nor
    writes the cache, and aggregate_snapshot reaches the same wall and marks
    its result unfit to keep.
    """
    try:
        present = [s for s in series_list
                   if builder.present(live_token if s in live_names else snap,
                                      s)]
    except SkipOffline:
        return None
    # The live token is part of the key because it is the only thing pinning
    # down content a snapshot stamp cannot vouch for.
    return aggregate_key(present, builder.components, builder.arches,
                         builder.pockets, builder.sources,
                         extra=live_token if live_names else None)


def collect(builder, snaps, series_list, separate=(), live_names=(),
            live_token=None, progress=True):
    """Aggregate each snapshot, with every series folded into one map.

    Series share one pool/, so a snapshot has to be aggregated whole rather
    than series by series: each row comes out carrying a bitmask of the series
    that reference it, which is what lets the page count a shared file once for
    any set of series you pick.

    All three of a snapshot's tables are cached once computed, the index tally
    included -- counting the indexes is a second full pass over the blobs, so
    it is if anything the half most worth not repeating.  A snapshot timestamp
    names a fixed state of the archive, so last month's answer cannot change,
    and the tables are a few thousand rows against the millions of packages
    behind them -- which is what makes adding one month to an existing page
    cost one snapshot's work rather than all of them.

    `separate` names series aggregated on their own and folded in afterwards,
    each under a cache key of its own.  That is only sound for a series that
    shares no pool file with the rest, and what it buys is cost: one series'
    aggregation rather than a whole snapshot's.  See SEPARATE_SERIES.
    """
    byclass = {}
    byflavour = {}
    byindex = {}
    seen = []
    started = time.time()
    for i, snap in enumerate(snaps, 1):
        key = snapshot_key(builder, snap, series_list, live_names, live_token)
        cached = builder.cache.get_aggregate(snap, key) if key else None
        if cached is not None:
            cls_table, flav_table, idx_table, here = cached
        else:
            cls_table, flav_table, idx_table, here, partial = \
                aggregate_snapshot(builder, snap, series_list,
                                   live_names=live_names,
                                   live_token=live_token)
            # Never cache a run that could not read everything it wanted: an
            # --offline miss looks exactly like a series that does not exist
            # yet, and would be indistinguishable once written down.
            if cls_table and not partial and key:
                builder.cache.put_aggregate(snap, key, cls_table,
                                            flav_table, idx_table, here)
        all_cached = cached is not None
        for extra in separate:
            if extra in series_list:
                continue
            e_here, e_cached = fold_separate(builder, snap, extra,
                                             byclass, byflavour, byindex)
            all_cached = all_cached and e_cached
            for name in e_here:
                if name not in seen:
                    seen.append(name)
        if cls_table:
            for k, acc in cls_table.items():
                byclass[(snap,) + k] = acc
            for k, acc in flav_table.items():
                byflavour[(snap,) + k] = acc
        for k, acc in idx_table.items():
            byindex[(snap,) + k] = acc
        for series in here:
            if series not in seen:
                seen.append(series)
        if progress:
            if all_cached:
                log("[%d/%d] %s  aggregate from cache, %.0fs"
                    % (i, len(snaps), snap, time.time() - started))
            else:
                log("[%d/%d] %s  %d blobs fetched (%.1f MiB), %d cached, %.0fs"
                    % (i, len(snaps), snap, builder.downloads,
                       builder.fetcher.bytes_downloaded / 2 ** 20,
                       builder.hits, time.time() - started))
    return byclass, byflavour, byindex, sorted(seen)


def encode(byclass, byflavour, byindex, snaps, series_list, mirrored=None,
           live_names=()):
    """Pack the tables into dimension dictionaries plus flat integer rows.

    The series dimension is a bitmask over series_list, not an index, so the
    page can union any subset without double-counting shared pool files.
    """
    def index(values):
        ordered = sorted(values)
        return ordered, {v: i for i, v in enumerate(ordered)}

    used_snaps = sorted({k[0] for k in byclass})
    snap_i = {v: i for i, v in enumerate(used_snaps)}
    # An index can exist and be empty -- a -proposed pocket nobody has uploaded
    # to yet -- so its architecture and component have to be taken from the
    # index table too, or its row would have nowhere to go.
    arches, arch_i = index({k[2] for k in byclass} | {k[2] for k in byflavour}
                           | {k[4] for k in byindex})
    comps, comp_i = index({k[3] for k in byclass} | {k[3] for k in byindex})
    classes, class_i = index({k[5] for k in byclass})
    flavours, flav_i = index({k[4] for k in byflavour})
    pocket_i = {p: i for i, p in enumerate(POCKETS)}

    # keep only the series that turned up, and renumber the masks to match
    used_bits = 0
    for k in byclass:
        used_bits |= k[1]
    for k in byindex:
        used_bits |= series_bit(k[1])
    # Release order, not SERIES_BITS order: that one records when each bit was
    # handed out, which has nothing to do with where a series sits in time.
    # Both maps are built from this list, so reordering it just reassigns the
    # output positions consistently.
    kept = series_order(s for s in series_list if used_bits & series_bit(s))
    slot = {name: i for i, name in enumerate(kept)}
    remap = {series_bit(name): 1 << i for name, i in slot.items()}

    def shrink(mask):
        out = 0
        for old_bit, new_bit in remap.items():
            if mask & old_bit:
                out |= new_bit
        return out

    cls_rows = []
    for (snap, smask, arch, comp, mask, cls), acc in sorted(byclass.items()):
        cls_rows += [snap_i[snap], shrink(smask), arch_i[arch], comp_i[comp],
                     mask, class_i[cls], acc[0], acc[1], acc[2]]
    flav_rows = []
    for (snap, smask, arch, mask, flav), acc in sorted(byflavour.items()):
        flav_rows += [snap_i[snap], shrink(smask), arch_i[arch], mask,
                      flav_i[flav], acc[0], acc[1], acc[2]]
    # One row per index file, so the pocket is a plain number here rather than
    # the bitmask the other tables carry: a Packages file belongs to exactly
    # one suite, and there is nothing to deduplicate.
    idx_rows = []
    for (snap, series, pocket, comp, arch), acc in sorted(byindex.items()):
        idx_rows += [snap_i[snap], slot[series],
                     arch_i[arch], comp_i[comp], pocket_i[pocket],
                     acc[0], acc[1], acc[2], acc[3]]

    # Which series the live archive still carries, for the page to open with.
    # Narrowed to the series that actually turned up, since those are all the
    # page has chips for.  None means the build had no probe to go on, and the
    # page should fall back to guessing.
    if mirrored is not None:
        still_there = set(mirrored)
        mirrored = [s for s in kept if s in still_there]

    return {
        "generated": datetime.datetime.now(
            datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%SZ"),
        "otherClass": OTHER,
        "pockets": POCKETS,
        "mirrored": mirrored,
        # Series the snapshot service cannot answer for, read from the live
        # archive and reported as of now.  Deliberately not in the tables
        # above: they have no history, and inventing one by attaching them to
        # the newest snapshot would put a step in every total.
        # Which series came from the live archive rather than from a
        # snapshot, so the page can say their history is the present held
        # constant.
        "liveSeries": [s for s in kept if s in set(live_names)] or None,
        # When each series left the mirror, for the page to explain why its
        # line stops.  Only the ones actually drawn.
        "mirrorRemoved": {s: MIRROR_REMOVED[s][1] for s in kept
                          if s in MIRROR_REMOVED} or None,
        "dims": {
            "snapshots": used_snaps,
            "series": kept,
            "arches": arches,
            "components": comps,
            "classes": classes,
            "flavours": flavours,
        },
        "byClass": {"stride": 9, "rows": cls_rows},
        "byFlavour": {"stride": 8, "rows": flav_rows},
        "byIndex": {"stride": 9, "rows": idx_rows},
    }


# How many leading columns of each table are keys rather than measurements.
# Keys are small, and the rows are emitted in sorted order, so a key column
# delta-encodes to almost nothing; a size column does not and is left alone.
TABLE_KEYS = {"byClass": 6, "byFlavour": 5, "byIndex": 5}


def varint(n, out):
    while True:
        b = n & 0x7f
        n >>= 7
        out.append(b | 0x80 if n else b)
        if not n:
            return


def zigzag(n):
    """Fold a signed delta onto the naturals, so -1 costs one byte, not ten."""
    return n << 1 if n >= 0 else (-n << 1) - 1


def pack_table(rows, stride, keys):
    """One table as columns of varints, key columns delta-encoded.

    Columnar because neighbouring rows agree in almost every key: sorted by
    key tuple, the snapshot column is a run of zero deltas and the rest are
    small.  Interleaved by row that structure is invisible to the compressor.
    """
    buf = bytearray()
    n = len(rows) // stride
    for c in range(stride):
        if c < keys:
            prev = 0
            for i in range(n):
                v = rows[i * stride + c]
                varint(zigzag(v - prev), buf)
                prev = v
        else:
            for i in range(n):
                varint(rows[i * stride + c], buf)
    return bytes(buf)


def encode_payload(data):
    """Split the dataset into a small JSON header and one packed binary blob.

    The blob is gzipped and base64'd so it can still live inside a single
    self-contained file that opens over file://, which a fetch could not.
    Base64 costs a third on disk and nothing on the wire, since gzipping the
    page undoes the expansion almost exactly.
    """
    blob = bytearray()
    tables = []
    for name in ("byClass", "byFlavour", "byIndex"):
        table = data[name]
        stride, keys = table["stride"], TABLE_KEYS[name]
        tables.append({"name": name, "stride": stride, "keys": keys,
                       "rows": len(table["rows"]) // stride})
        blob += pack_table(table["rows"], stride, keys)
    packed = gzip.compress(bytes(blob), 9)
    header = {k: v for k, v in data.items() if k not in
              ("byClass", "byFlavour", "byIndex")}
    header["tables"] = tables
    header["blob"] = base64.b64encode(packed).decode("ascii")
    return header, len(blob), len(packed)


def write_html(path, data):
    here = os.path.dirname(os.path.abspath(__file__))
    with open(os.path.join(here, "template.html")) as f:
        template = f.read()
    header, raw, packed = encode_payload(data)
    payload = json.dumps(header, separators=(",", ":"))
    html = template.replace("/*DATA*/null/*DATA*/", payload)
    with open(path, "w") as f:
        f.write(html)
    log("wrote %s (%.1f MiB; %.1f MiB packed, %.1f MiB gzipped)"
        % (path, len(html) / 2 ** 20, raw / 2 ** 20, packed / 2 ** 20))


def cmd_build(args):
    if args.from_json:
        with open(args.from_json) as f:
            write_html(args.output, json.load(f))
        return 0
    builder = make_builder(args)
    snaps = snapshots(args.from_, args.to, args.every)
    series_list, separate = requested_series(args.series)
    # Where these go in the list no longer decides anything: bits come from
    # SERIES_BITS, not from a position here.  It used to, and appending a
    # candidate in front of trusty and xenial moved both of their bits.
    live_names = [] if args.series else [s for s in LIVE_SERIES
                                         if s not in series_list]
    token = live_token(builder, live_names, args.refresh_live)
    if token is None:
        live_names = []
    all_series = (series_list + [s for s in separate if s not in series_list]
                  + live_names)
    log("%d snapshot(s) x %d candidate series%s; cache at %s"
        % (len(snaps), len(all_series),
           " (%s from the live archive)" % " ".join(live_names) if live_names
           else "", args.cache))

    mirrored = mirror_series(builder, all_series)
    byclass, byflavour, byindex, seen = collect(
        builder, snaps, series_list + live_names, separate=separate,
        live_names=live_names, live_token=token)
    if not byclass:
        log("nothing collected -- wrong window, or an --offline run with a "
            "cold cache")
        return 1
    byclass, byflavour, byindex, dropped = drop_removed(
        byclass, byflavour, byindex, all_series)
    if dropped:
        log("not counting %.1f GiB at the latest snapshot: %s left the mirror"
            % (dropped / 2 ** 30,
               ", ".join(s for s in all_series if s in MIRROR_REMOVED)))
    data = encode(byclass, byflavour, byindex, snaps, all_series,
                  mirrored=mirrored, live_names=live_names)
    log("collected %d class rows, %d flavour rows, %d index rows across %s"
        % (len(data["byClass"]["rows"]) // 9,
           len(data["byFlavour"]["rows"]) // 8,
           len(data["byIndex"]["rows"]) // 9, ", ".join(seen)))

    if args.json:
        payload = json.dumps(data, separators=(",", ":"))
        with open(args.json, "w") as f:
            f.write(payload)
        log("wrote %s (%.1f MiB)" % (args.json, len(payload) / 2 ** 20))
    if args.output:
        write_html(args.output, data)
    return 0


def human(n):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024 or unit == "TiB":
            return "%.1f %s" % (n, unit)
        n /= 1024.0


def cmd_report(args):
    builder = make_builder(args)
    snaps = snapshots(args.snapshot, args.snapshot, "month") \
        if args.snapshot else snapshots(None, None, "month")[-1:]
    series_list, separate = requested_series(args.series)
    byclass, _flav, _idx, seen = collect(builder, snaps, series_list,
                                         separate=separate, progress=False)
    # Which series to report on; the masks name them by SERIES_BITS bit.
    series_list = series_list + [s for s in separate if s not in series_list]

    # A row's series mask says which series reference that file.  Adding a row
    # into every series it touches gives each series its own honest total; the
    # archive line adds each row once instead, which is why the two differ.
    per = {}
    archive = {}
    for (snap, smask, arch, _comp, _mask, cls), acc in byclass.items():
        slot = archive.setdefault((snap, arch), [0, 0, 0, 0])
        slot[0] += acc[1]
        slot[1] += acc[0]
        if cls != OTHER:
            slot[2] += acc[1]
            slot[3] += acc[0]
        for name in series_list:
            if not smask & series_bit(name):
                continue
            slot = per.setdefault((snap, name, arch), [0, 0, 0, 0])
            slot[0] += acc[1]
            slot[1] += acc[0]
            if cls != OTHER:
                slot[2] += acc[1]
                slot[3] += acc[0]

    grand = [0, 0]
    for key in sorted(per):
        total, ntotal, kern, nkern = per[key]
        grand[0] += total
        grand[1] += kern
        print("%s %-9s %-8s  kernel %10s / %10s  %5.1f%%  (%d/%d pkgs)"
              % (key[0][:8], key[1], key[2], human(kern), human(total),
                 100.0 * kern / total if total else 0, nkern, ntotal))

    kern = total = 0
    for slot in archive.values():
        total += slot[0]
        kern += slot[2]
    if grand[0]:
        print("%-38s  %10s / %10s  %5.1f%%"
              % ("sum of series", human(grand[1]), human(grand[0]),
                 100.0 * grand[1] / grand[0]))
    if total:
        print("%-38s  %10s / %10s  %5.1f%%"
              % ("whole archive (pool deduped)", human(kern), human(total),
                 100.0 * kern / total))
        if grand[0] > total:
            print("%-38s  %10s  (%.1f%% of the archive, counted once per "
                  "series that references it)"
                  % ("...files shared between series",
                     human(grand[0] - total),
                     100.0 * (grand[0] - total) / total))
    return 0


# Trailing version token in a source name: the -14 of gcc-14-cross, the -8.0 of
# mysql-8.0, the -13-2 of libcublas-13-2.  Only a token introduced by a dash
# counts, so dotnet8 and libc6 keep their digits -- guessing at those would
# merge far more than it would split.
VERSION_TOKEN = re.compile(r"-(\d+(?:[.-]\d+)*)(?=$|-)")


def family_of(src):
    """Collapse a source name to the family its versioned siblings share.

    gcc-14-cross and gcc-13-cross both become gcc-cross; libcublas-13-1 and
    libcublas-13-2 both become libcublas.  That is what turns "34 sources I do
    not recognise" into "one family carrying six simultaneous versions".
    """
    stripped = VERSION_TOKEN.sub("", src, count=1)
    return stripped or src


def collect_sources(builder, snaps, series_list, match=None, family=False,
                    kernels="include", progress=True):
    """Bytes per source package (or family) per snapshot.

    Every pool file is counted once, the same way the archive-wide totals are:
    a snapshot's series are merged before anything is counted, so a file that
    jammy and noble both reference adds its size once rather than twice.  These
    numbers are therefore comparable to the "whole archive" line in report, and
    deliberately not to the per-series lines above it.
    """
    totals = {}       # (snap, group) -> [bytes, files, {source names}]
    archive = {}      # snap -> [all bytes, kernel bytes]
    seen = []
    started = time.time()
    for i, snap in enumerate(snaps, 1):
        whole = {}
        for series in series_list:
            try:
                rows = builder.load_rows(snap, series)
            except SkipOffline:
                continue
            if rows is None:
                continue
            if series not in seen:
                seen.append(series)
            merge_rows(whole, rows, series_bit(series))
            del rows
        if whole:
            is_kernel_row = kernel_predicate(whole)
            overall = archive.setdefault(snap, [0, 0])
            for (pkg, _ver, _arch), row in whole.items():
                name = pkg.decode()
                kernel = is_kernel_row(name, row.src)
                overall[0] += row.size
                if kernel:
                    overall[1] += row.size
                if kernels == "only" and not kernel:
                    continue
                if kernels == "skip" and kernel:
                    continue
                if match is not None and not match.search(row.src):
                    continue
                group = family_of(row.src) if family else row.src
                acc = totals.setdefault((snap, group), [0, 0, set()])
                acc[0] += row.size
                acc[1] += 1
                acc[2].add(row.src)
            del whole
        if progress:
            log("[%d/%d] %s  %d blobs fetched (%.1f MiB), %d cached, %.0fs"
                % (i, len(snaps), snap, builder.downloads,
                   builder.fetcher.bytes_downloaded / 2 ** 20,
                   builder.hits, time.time() - started))
    return totals, archive, sorted(seen)


def print_one_snapshot(totals, archive, snap, groups, family):
    """Ranked table for a single point in time."""
    total = archive[snap][0]
    print("%9s %7s %7s %5s  %s"
          % ("bytes", "%arch", "files", "vers", "family" if family else "source"))
    for group in groups:
        size, files, members = totals[(snap, group)]
        print("%9s %6.2f%% %7d %5d  %s"
              % (human(size), 100.0 * size / total if total else 0,
                 files, len(members), group))
    shown = sum(totals[(snap, g)][0] for g in groups)
    rest = sum(v[0] for (s, _g), v in totals.items() if s == snap) - shown
    others = sum(1 for (s, _g) in totals if s == snap) - len(groups)
    if others > 0:
        print("%9s %6.2f%% %7s %5s  ...and %d more"
              % (human(rest), 100.0 * rest / total if total else 0,
                 "", "", others))


def print_over_time(totals, archive, used, groups, family):
    """One row per group, one column per snapshot, plus how it moved.

    The share column is the one to read.  The archive itself grows as series
    pile up -- the snapshot service never drops an EOL suite -- so an absolute
    multiplier flatters every row alike; a family only deserves attention if it
    is outgrowing the thing it sits in.
    """
    cols = "".join("%10s" % s[:6] for s in used)
    first, last = used[0], used[-1]
    print("%-24s%s %8s %10s"
          % ("family" if family else "source", cols, "growth", "share"))
    for label, which in (("archive total", 0), ("...of which kernels", 1)):
        print("%-24s%s" % (label,
                           "".join("%10s" % human(archive[s][which])
                                   for s in used)))
    print()
    for group in groups:
        vals = [totals.get((s, group), [0])[0] for s in used]
        cells = "".join("%10s" % human(v) for v in vals)
        grew = "%7.2fx" % (vals[-1] / vals[0]) if vals[0] else "%8s" % "new"
        share0 = 100.0 * vals[0] / archive[first][0] if archive[first][0] else 0
        share1 = 100.0 * vals[-1] / archive[last][0] if archive[last][0] else 0
        print("%-24s%s %8s %+9.2fpp"
              % (group[:24], cells, grew, share1 - share0))


def cmd_breakdown(args):
    builder = make_builder(args)
    if args.from_ or args.to:
        snaps = snapshots(args.from_, args.to, args.every)
    elif args.snapshot:
        snaps = snapshots(args.snapshot, args.snapshot, "month")
    else:
        snaps = snapshots(None, None, "month")[-1:]
    main, separate = requested_series(args.series)
    # One list: collect_sources merges the pool itself rather than trusting
    # the split, which is what makes it the check on SEPARATE_SERIES.
    series_list = main + [s for s in separate if s not in main]
    match = re.compile(args.match) if args.match else None
    kernels = "include"
    if args.kernels_only:
        kernels = "only"
    elif args.no_kernels:
        kernels = "skip"

    totals, archive, seen = collect_sources(
        builder, snaps, series_list, match=match, family=args.family,
        kernels=kernels, progress=len(snaps) > 1)
    if not archive:
        log("nothing collected -- wrong window, or an --offline run with a "
            "cold cache")
        return 1

    used = sorted(archive)
    last = used[-1]
    # Rank on the most recent snapshot, so the table answers "what is big now".
    # A group that has since vanished still ranks on its largest showing rather
    # than dropping silently off the end of the list.
    rank = {}
    for (snap, group), acc in totals.items():
        best = rank.setdefault(group, [0, 0])
        if snap == last:
            best[0] = acc[0]
        best[1] = max(best[1], acc[0])
    groups = sorted(rank, key=lambda g: (-rank[g][0], -rank[g][1], g))[:args.top]

    when = (used[0][:8] if len(used) == 1
            else "%s..%s, %d snapshots" % (used[0][:8], used[-1][:8], len(used)))
    print("%s; %d series (%s)" % (when, len(seen), ", ".join(seen)))
    if not groups:
        print("nothing matched")
        return 0
    if len(used) == 1:
        print_one_snapshot(totals, archive, last, groups, args.family)
    else:
        print_over_time(totals, archive, used, groups, args.family)
    return 0


def cmd_cache(args):
    cache = Cache(args.cache)
    files, total = cache.usage()
    print("%s: %d files, %s" % (args.cache, files, human(total)))
    return 0


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("build", help="fetch and write the interactive page")
    add_common(p)
    add_window(p)
    p.add_argument("-o", "--output", default="kernels.html", metavar="FILE",
                   help="HTML output (default: %(default)s)")
    p.add_argument("--json", metavar="FILE",
                   help="also write the raw dataset here")
    p.add_argument("--refresh-live", action="store_true",
                   help="re-read the series the snapshot service does not "
                        "carry from the live archive; they are pinned "
                        "otherwise, since a change re-aggregates everything")
    p.add_argument("--from-json", dest="from_json", metavar="FILE",
                   help="re-render the page from a dataset written by --json, "
                        "skipping the cache entirely; handy after editing "
                        "template.html")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("report", help="text summary of a single snapshot")
    add_common(p)
    p.add_argument("--snapshot", metavar="YYYY-MM",
                   help="which snapshot (default: the most recent month)")
    p.set_defaults(func=cmd_report)

    p = sub.add_parser("breakdown",
                       help="where the archive's space goes, by source package")
    add_common(p)
    add_window(p)
    p.add_argument("--snapshot", metavar="YYYY-MM",
                   help="a single snapshot (default: the most recent month); "
                        "ignored when --from/--to are given")
    p.add_argument("-n", "--top", type=int, default=25, metavar="N",
                   help="how many rows to show (default: %(default)s)")
    p.add_argument("--family", action="store_true",
                   help="group versioned siblings together, so gcc-13-cross "
                        "and gcc-14-cross count as one gcc-cross")
    p.add_argument("--match", metavar="REGEX",
                   help="only sources whose name matches, e.g. "
                        "--match -- '-13-[0-9]+$' for one CUDA stack")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--no-kernels", action="store_true",
                   help="drop kernel packages, which otherwise fill the table")
    g.add_argument("--kernels-only", action="store_true",
                   help="keep only kernel packages")
    p.set_defaults(func=cmd_breakdown)

    p = sub.add_parser("cache", help="show what the cache is holding")
    p.add_argument("--cache", default=default_cache_dir(), metavar="DIR")
    p.set_defaults(func=cmd_cache)

    args = parser.parse_args()
    try:
        return args.func(args)
    except KeyboardInterrupt:
        log("interrupted; the cache keeps what was already fetched")
        return 130


if __name__ == "__main__":
    sys.exit(main())
