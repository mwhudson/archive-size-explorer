#!/usr/bin/env python3
"""Explore how much of the Ubuntu archive is taken up by kernels.

Reads binary and source indexes straight from the Ubuntu snapshot service, so
it can look at any point in time since 2023-03-01 rather than just whatever
apt happens to have locally.  Everything it downloads is reduced and cached, so
the expensive first run is the only expensive run.

  kernel-sizes-explorer build -o kernels.html     # fetch + write the page
  kernel-sizes-explorer report -s noble           # text summary of one snapshot
  kernel-sizes-explorer breakdown --family        # where the space actually goes
  kernel-sizes-explorer cache                     # what the cache is holding

The output of "build" is a single self-contained HTML file: open it with
file://, no server needed.
"""

import argparse
import datetime
import json
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from kernel_sizes import (  # noqa: E402
    Builder, Cache, Fetcher, CANDIDATE_SERIES, DEFAULT_COMPONENTS, OTHER,
    POCKETS, aggregate, count_index, default_cache_dir, kernel_predicate, log,
    merge_rows, snapshots,
)


def series_order(names):
    """Release order, so the page can treat a higher index as 'more recent'."""
    return sorted(names, key=lambda n: (CANDIDATE_SERIES.index(n)
                                        if n in CANDIDATE_SERIES else len(CANDIDATE_SERIES),
                                        n))


def add_common(parser):
    parser.add_argument("-s", "--series", action="append", metavar="SERIES",
                        help="series to include; repeatable "
                             "(default: every series present in the window)")
    parser.add_argument("-a", "--arch", action="append", metavar="ARCH",
                        help="binary architecture; repeatable "
                             "(default: every arch each suite advertises)")
    parser.add_argument("-p", "--pocket", action="append", metavar="POCKET",
                        choices=POCKETS,
                        help="pocket; repeatable (default: all of %s)"
                             % ", ".join(POCKETS))
    parser.add_argument("-c", "--component", action="append", metavar="COMP",
                        choices=DEFAULT_COMPONENTS,
                        help="component; repeatable (default: all four)")
    parser.add_argument("--no-sources", action="store_true",
                        help="skip source packages (they show up as arch "
                             "'source')")
    parser.add_argument("--cache", default=default_cache_dir(), metavar="DIR",
                        help="cache directory (default: %(default)s)")
    parser.add_argument("-j", "--jobs", type=int, default=8, metavar="N",
                        help="parallel downloads (default: %(default)s)")
    parser.add_argument("--offline", action="store_true",
                        help="use only what is already cached; skip anything "
                             "that would need the network")


def add_window(parser):
    parser.add_argument("--from", dest="from_", default=None, metavar="YYYY-MM",
                        help="first snapshot (default: 2023-03, the earliest "
                             "the snapshot service has)")
    parser.add_argument("--to", default=None, metavar="YYYY-MM",
                        help="last snapshot (default: today)")
    parser.add_argument("--every", default="month", metavar="SPEC",
                        help="'month' (default), 'week', or a number of days")


def make_builder(args):
    cache = Cache(args.cache)
    fetcher = Fetcher(jobs=args.jobs)
    builder = Builder(cache, fetcher,
                      components=args.component,
                      arches=args.arch,
                      pockets=args.pocket,
                      sources=not args.no_sources)
    if args.offline:
        builder.fetcher = OfflineFetcher()
    return builder


class OfflineFetcher:
    jobs = 1
    bytes_downloaded = 0

    def get(self, url, tolerate_404=True):
        raise SkipOffline(url)


class SkipOffline(Exception):
    pass


def tally_indexes(cache, plans, is_kernel, snap, into):
    """Size and entry count of every index behind one snapshot.

    Deliberately not deduplicated: the archive really does publish one
    binary-<arch>/Packages per component per pocket per series, and an
    Architecture: all package really is a stanza in each of them.  That is what
    makes this table different in kind from the others -- it measures the lists
    rather than the pool they point at.

    A second pass over the blobs, because kernel-ness is a property of the
    whole snapshot and is not known until every index has been read.  Nothing
    is downloaded here; load_rows has already put it all in the cache.
    """
    counted = {}
    for series, plan in plans:
        for ix in plan:
            tally = counted.get(ix.sha)
            if tally is None:
                tally = counted[ix.sha] = count_index(cache, ix.sha, is_kernel)
            acc = into.setdefault(
                (snap, series, ix.pocket, ix.component, ix.arch), [0, 0, 0, 0])
            acc[0] += tally[0]
            acc[1] += tally[1]
            acc[2] += ix.csize
            acc[3] += ix.usize


def collect(builder, snaps, series_list, progress=True):
    """Aggregate each snapshot, with every series folded into one map.

    Series share one pool/, so a snapshot has to be aggregated whole rather
    than series by series: each row comes out carrying a bitmask of the series
    that reference it, which is what lets the page count a shared file once for
    any set of series you pick.
    """
    byclass = {}
    byflavour = {}
    byindex = {}
    seen = []
    started = time.time()
    for i, snap in enumerate(snaps, 1):
        whole = {}
        plans = []
        for series in series_list:
            try:
                rows = builder.load_rows(snap, series)
            except SkipOffline:
                continue
            if rows is None:
                continue
            if series not in seen:
                seen.append(series)
            plans.append((series, builder.plan(snap, series)))
            merge_rows(whole, rows, 1 << series_list.index(series))
            del rows
        if whole:
            is_kernel = kernel_predicate(whole)
            cls_table, flav_table = aggregate(whole, is_kernel)
            for key, acc in cls_table.items():
                byclass[(snap,) + key] = acc
            for key, acc in flav_table.items():
                byflavour[(snap,) + key] = acc
            tally_indexes(builder.cache, plans, is_kernel, snap, byindex)
            del whole
        if progress:
            log("[%d/%d] %s  %d blobs fetched (%.1f MiB), %d cached, %.0fs"
                % (i, len(snaps), snap, builder.downloads,
                   builder.fetcher.bytes_downloaded / 2 ** 20,
                   builder.hits, time.time() - started))
    return byclass, byflavour, byindex, sorted(seen)


def encode(byclass, byflavour, byindex, snaps, series_list):
    """Pack the tables into dimension dictionaries plus flat integer rows.

    The series dimension is a bitmask over series_list, not an index, so the
    page can union any subset without double-counting shared pool files.
    """
    def index(values):
        ordered = sorted(values)
        return ordered, {v: i for i, v in enumerate(ordered)}

    used_snaps = sorted({k[0] for k in byclass})
    snap_i = {v: i for i, v in enumerate(used_snaps)}
    # An index can exist and be empty -- a -proposed pocket nobody has uploaded
    # to yet -- so its architecture and component have to be taken from the
    # index table too, or its row would have nowhere to go.
    arches, arch_i = index({k[2] for k in byclass} | {k[2] for k in byflavour}
                           | {k[4] for k in byindex})
    comps, comp_i = index({k[3] for k in byclass} | {k[3] for k in byindex})
    classes, class_i = index({k[5] for k in byclass})
    flavours, flav_i = index({k[4] for k in byflavour})
    pocket_i = {p: i for i, p in enumerate(POCKETS)}

    # keep only the series that turned up, and renumber the masks to match
    used_bits = 0
    for k in byclass:
        used_bits |= k[1]
    for k in byindex:
        used_bits |= 1 << series_list.index(k[1])
    kept = [s for i, s in enumerate(series_list) if used_bits >> i & 1]
    remap = {}
    for new_i, name in enumerate(kept):
        remap[series_list.index(name)] = new_i

    def shrink(mask):
        out = 0
        for old_i, new_i in remap.items():
            if mask >> old_i & 1:
                out |= 1 << new_i
        return out

    cls_rows = []
    for (snap, smask, arch, comp, mask, cls), acc in sorted(byclass.items()):
        cls_rows += [snap_i[snap], shrink(smask), arch_i[arch], comp_i[comp],
                     mask, class_i[cls], acc[0], acc[1], acc[2]]
    flav_rows = []
    for (snap, smask, arch, mask, flav), acc in sorted(byflavour.items()):
        flav_rows += [snap_i[snap], shrink(smask), arch_i[arch], mask,
                      flav_i[flav], acc[0], acc[1], acc[2]]
    # One row per index file, so the pocket is a plain number here rather than
    # the bitmask the other tables carry: a Packages file belongs to exactly
    # one suite, and there is nothing to deduplicate.
    idx_rows = []
    for (snap, series, pocket, comp, arch), acc in sorted(byindex.items()):
        idx_rows += [snap_i[snap], remap[series_list.index(series)],
                     arch_i[arch], comp_i[comp], pocket_i[pocket],
                     acc[0], acc[1], acc[2], acc[3]]

    return {
        "generated": datetime.datetime.now(
            datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%SZ"),
        "otherClass": OTHER,
        "pockets": POCKETS,
        "dims": {
            "snapshots": used_snaps,
            "series": kept,
            "arches": arches,
            "components": comps,
            "classes": classes,
            "flavours": flavours,
        },
        "byClass": {"stride": 9, "rows": cls_rows},
        "byFlavour": {"stride": 8, "rows": flav_rows},
        "byIndex": {"stride": 9, "rows": idx_rows},
    }


def write_html(path, payload):
    here = os.path.dirname(os.path.abspath(__file__))
    with open(os.path.join(here, "template.html")) as f:
        template = f.read()
    html = template.replace("/*DATA*/null/*DATA*/", payload)
    with open(path, "w") as f:
        f.write(html)
    log("wrote %s (%.1f MiB)" % (path, len(html) / 2 ** 20))


def cmd_build(args):
    if args.from_json:
        with open(args.from_json) as f:
            payload = f.read()
        write_html(args.output, payload)
        return 0
    builder = make_builder(args)
    snaps = snapshots(args.from_, args.to, args.every)
    series_list = args.series or CANDIDATE_SERIES
    log("%d snapshot(s) x %d candidate series; cache at %s"
        % (len(snaps), len(series_list), args.cache))

    byclass, byflavour, byindex, seen = collect(builder, snaps, series_list)
    if not byclass:
        log("nothing collected -- wrong window, or an --offline run with a "
            "cold cache")
        return 1
    data = encode(byclass, byflavour, byindex, snaps, series_list)
    log("collected %d class rows, %d flavour rows, %d index rows across %s"
        % (len(data["byClass"]["rows"]) // 9,
           len(data["byFlavour"]["rows"]) // 8,
           len(data["byIndex"]["rows"]) // 9, ", ".join(seen)))

    payload = json.dumps(data, separators=(",", ":"))
    if args.json:
        with open(args.json, "w") as f:
            f.write(payload)
        log("wrote %s (%.1f MiB)" % (args.json, len(payload) / 2 ** 20))
    if args.output:
        write_html(args.output, payload)
    return 0


def human(n):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024 or unit == "TiB":
            return "%.1f %s" % (n, unit)
        n /= 1024.0


def cmd_report(args):
    builder = make_builder(args)
    snaps = snapshots(args.snapshot, args.snapshot, "month") \
        if args.snapshot else snapshots(None, None, "month")[-1:]
    series_list = args.series or CANDIDATE_SERIES
    byclass, _flav, _idx, seen = collect(builder, snaps, series_list,
                                         progress=False)

    # A row's series mask says which series reference that file.  Adding a row
    # into every series it touches gives each series its own honest total; the
    # archive line adds each row once instead, which is why the two differ.
    per = {}
    archive = {}
    for (snap, smask, arch, _comp, _mask, cls), acc in byclass.items():
        slot = archive.setdefault((snap, arch), [0, 0, 0, 0])
        slot[0] += acc[1]
        slot[1] += acc[0]
        if cls != OTHER:
            slot[2] += acc[1]
            slot[3] += acc[0]
        for i, name in enumerate(series_list):
            if not smask >> i & 1:
                continue
            slot = per.setdefault((snap, name, arch), [0, 0, 0, 0])
            slot[0] += acc[1]
            slot[1] += acc[0]
            if cls != OTHER:
                slot[2] += acc[1]
                slot[3] += acc[0]

    grand = [0, 0]
    for key in sorted(per):
        total, ntotal, kern, nkern = per[key]
        grand[0] += total
        grand[1] += kern
        print("%s %-9s %-8s  kernel %10s / %10s  %5.1f%%  (%d/%d pkgs)"
              % (key[0][:8], key[1], key[2], human(kern), human(total),
                 100.0 * kern / total if total else 0, nkern, ntotal))

    kern = total = 0
    for slot in archive.values():
        total += slot[0]
        kern += slot[2]
    if grand[0]:
        print("%-38s  %10s / %10s  %5.1f%%"
              % ("sum of series", human(grand[1]), human(grand[0]),
                 100.0 * grand[1] / grand[0]))
    if total:
        print("%-38s  %10s / %10s  %5.1f%%"
              % ("whole archive (pool deduped)", human(kern), human(total),
                 100.0 * kern / total))
        if grand[0] > total:
            print("%-38s  %10s  (%.1f%% of the archive, counted once per "
                  "series that references it)"
                  % ("...files shared between series",
                     human(grand[0] - total),
                     100.0 * (grand[0] - total) / total))
    return 0


# Trailing version token in a source name: the -14 of gcc-14-cross, the -8.0 of
# mysql-8.0, the -13-2 of libcublas-13-2.  Only a token introduced by a dash
# counts, so dotnet8 and libc6 keep their digits -- guessing at those would
# merge far more than it would split.
VERSION_TOKEN = re.compile(r"-(\d+(?:[.-]\d+)*)(?=$|-)")


def family_of(src):
    """Collapse a source name to the family its versioned siblings share.

    gcc-14-cross and gcc-13-cross both become gcc-cross; libcublas-13-1 and
    libcublas-13-2 both become libcublas.  That is what turns "34 sources I do
    not recognise" into "one family carrying six simultaneous versions".
    """
    stripped = VERSION_TOKEN.sub("", src, count=1)
    return stripped or src


def collect_sources(builder, snaps, series_list, match=None, family=False,
                    kernels="include", progress=True):
    """Bytes per source package (or family) per snapshot.

    Every pool file is counted once, the same way the archive-wide totals are:
    a snapshot's series are merged before anything is counted, so a file that
    jammy and noble both reference adds its size once rather than twice.  These
    numbers are therefore comparable to the "whole archive" line in report, and
    deliberately not to the per-series lines above it.
    """
    totals = {}       # (snap, group) -> [bytes, files, {source names}]
    archive = {}      # snap -> [all bytes, kernel bytes]
    seen = []
    started = time.time()
    for i, snap in enumerate(snaps, 1):
        whole = {}
        for series in series_list:
            try:
                rows = builder.load_rows(snap, series)
            except SkipOffline:
                continue
            if rows is None:
                continue
            if series not in seen:
                seen.append(series)
            merge_rows(whole, rows, 1 << series_list.index(series))
            del rows
        if whole:
            is_kernel_row = kernel_predicate(whole)
            overall = archive.setdefault(snap, [0, 0])
            for (pkg, _ver, _arch), row in whole.items():
                name = pkg.decode()
                kernel = is_kernel_row(name, row.src)
                overall[0] += row.size
                if kernel:
                    overall[1] += row.size
                if kernels == "only" and not kernel:
                    continue
                if kernels == "skip" and kernel:
                    continue
                if match is not None and not match.search(row.src):
                    continue
                group = family_of(row.src) if family else row.src
                acc = totals.setdefault((snap, group), [0, 0, set()])
                acc[0] += row.size
                acc[1] += 1
                acc[2].add(row.src)
            del whole
        if progress:
            log("[%d/%d] %s  %d blobs fetched (%.1f MiB), %d cached, %.0fs"
                % (i, len(snaps), snap, builder.downloads,
                   builder.fetcher.bytes_downloaded / 2 ** 20,
                   builder.hits, time.time() - started))
    return totals, archive, sorted(seen)


def print_one_snapshot(totals, archive, snap, groups, family):
    """Ranked table for a single point in time."""
    total = archive[snap][0]
    print("%9s %7s %7s %5s  %s"
          % ("bytes", "%arch", "files", "vers", "family" if family else "source"))
    for group in groups:
        size, files, members = totals[(snap, group)]
        print("%9s %6.2f%% %7d %5d  %s"
              % (human(size), 100.0 * size / total if total else 0,
                 files, len(members), group))
    shown = sum(totals[(snap, g)][0] for g in groups)
    rest = sum(v[0] for (s, _g), v in totals.items() if s == snap) - shown
    others = sum(1 for (s, _g) in totals if s == snap) - len(groups)
    if others > 0:
        print("%9s %6.2f%% %7s %5s  ...and %d more"
              % (human(rest), 100.0 * rest / total if total else 0,
                 "", "", others))


def print_over_time(totals, archive, used, groups, family):
    """One row per group, one column per snapshot, plus how it moved.

    The share column is the one to read.  The archive itself grows as series
    pile up -- the snapshot service never drops an EOL suite -- so an absolute
    multiplier flatters every row alike; a family only deserves attention if it
    is outgrowing the thing it sits in.
    """
    cols = "".join("%10s" % s[:6] for s in used)
    first, last = used[0], used[-1]
    print("%-24s%s %8s %10s"
          % ("family" if family else "source", cols, "growth", "share"))
    for label, which in (("archive total", 0), ("...of which kernels", 1)):
        print("%-24s%s" % (label,
                           "".join("%10s" % human(archive[s][which])
                                   for s in used)))
    print()
    for group in groups:
        vals = [totals.get((s, group), [0])[0] for s in used]
        cells = "".join("%10s" % human(v) for v in vals)
        grew = "%7.2fx" % (vals[-1] / vals[0]) if vals[0] else "%8s" % "new"
        share0 = 100.0 * vals[0] / archive[first][0] if archive[first][0] else 0
        share1 = 100.0 * vals[-1] / archive[last][0] if archive[last][0] else 0
        print("%-24s%s %8s %+9.2fpp"
              % (group[:24], cells, grew, share1 - share0))


def cmd_breakdown(args):
    builder = make_builder(args)
    if args.from_ or args.to:
        snaps = snapshots(args.from_, args.to, args.every)
    elif args.snapshot:
        snaps = snapshots(args.snapshot, args.snapshot, "month")
    else:
        snaps = snapshots(None, None, "month")[-1:]
    series_list = args.series or CANDIDATE_SERIES
    match = re.compile(args.match) if args.match else None
    kernels = "include"
    if args.kernels_only:
        kernels = "only"
    elif args.no_kernels:
        kernels = "skip"

    totals, archive, seen = collect_sources(
        builder, snaps, series_list, match=match, family=args.family,
        kernels=kernels, progress=len(snaps) > 1)
    if not archive:
        log("nothing collected -- wrong window, or an --offline run with a "
            "cold cache")
        return 1

    used = sorted(archive)
    last = used[-1]
    # Rank on the most recent snapshot, so the table answers "what is big now".
    # A group that has since vanished still ranks on its largest showing rather
    # than dropping silently off the end of the list.
    rank = {}
    for (snap, group), acc in totals.items():
        best = rank.setdefault(group, [0, 0])
        if snap == last:
            best[0] = acc[0]
        best[1] = max(best[1], acc[0])
    groups = sorted(rank, key=lambda g: (-rank[g][0], -rank[g][1], g))[:args.top]

    when = (used[0][:8] if len(used) == 1
            else "%s..%s, %d snapshots" % (used[0][:8], used[-1][:8], len(used)))
    print("%s; %d series (%s)" % (when, len(seen), ", ".join(seen)))
    if not groups:
        print("nothing matched")
        return 0
    if len(used) == 1:
        print_one_snapshot(totals, archive, last, groups, args.family)
    else:
        print_over_time(totals, archive, used, groups, args.family)
    return 0


def cmd_cache(args):
    cache = Cache(args.cache)
    files, total = cache.usage()
    print("%s: %d files, %s" % (args.cache, files, human(total)))
    return 0


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("build", help="fetch and write the interactive page")
    add_common(p)
    add_window(p)
    p.add_argument("-o", "--output", default="kernels.html", metavar="FILE",
                   help="HTML output (default: %(default)s)")
    p.add_argument("--json", metavar="FILE",
                   help="also write the raw dataset here")
    p.add_argument("--from-json", dest="from_json", metavar="FILE",
                   help="re-render the page from a dataset written by --json, "
                        "skipping the cache entirely; handy after editing "
                        "template.html")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("report", help="text summary of a single snapshot")
    add_common(p)
    p.add_argument("--snapshot", metavar="YYYY-MM",
                   help="which snapshot (default: the most recent month)")
    p.set_defaults(func=cmd_report)

    p = sub.add_parser("breakdown",
                       help="where the archive's space goes, by source package")
    add_common(p)
    add_window(p)
    p.add_argument("--snapshot", metavar="YYYY-MM",
                   help="a single snapshot (default: the most recent month); "
                        "ignored when --from/--to are given")
    p.add_argument("-n", "--top", type=int, default=25, metavar="N",
                   help="how many rows to show (default: %(default)s)")
    p.add_argument("--family", action="store_true",
                   help="group versioned siblings together, so gcc-13-cross "
                        "and gcc-14-cross count as one gcc-cross")
    p.add_argument("--match", metavar="REGEX",
                   help="only sources whose name matches, e.g. "
                        "--match -- '-13-[0-9]+$' for one CUDA stack")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--no-kernels", action="store_true",
                   help="drop kernel packages, which otherwise fill the table")
    g.add_argument("--kernels-only", action="store_true",
                   help="keep only kernel packages")
    p.set_defaults(func=cmd_breakdown)

    p = sub.add_parser("cache", help="show what the cache is holding")
    p.add_argument("--cache", default=default_cache_dir(), metavar="DIR")
    p.set_defaults(func=cmd_cache)

    args = parser.parse_args()
    try:
        return args.func(args)
    except KeyboardInterrupt:
        log("interrupted; the cache keeps what was already fetched")
        return 130


if __name__ == "__main__":
    sys.exit(main())
